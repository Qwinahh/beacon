{
  "choices": [
    {
      "id": "trade-entry",
      "name": "📊 Log Trade",
      "type": "Capture",
      "command": true,
      "captureToActiveFile": false,
      "captureTo": "journal/{{DATE:YYYY}}/{{DATE:MM-MMMM}}/{{DATE:YYYY-MM-DD}}.md",
      "createFileIfItDoesntExist": true,
      "captureFormat": "\n## Trade: {{VALUE:Coin/Project}} — {{DATE:YYYY-MM-DD HH:mm}}\n- Entry: {{VALUE:Entry price}}\n- Size: {{VALUE:Position size}}\n- Thesis: {{VALUE:Why?}}\n- Stop: {{VALUE:Stop loss}}\n- Target: {{VALUE:Take profit}}\n",
      "prepend": false,
      "task": false
    },
    {
      "id": "alpha-note",
      "name": "⚡ Quick Alpha",
      "type": "Capture",
      "command": true,
      "captureToActiveFile": false,
      "captureTo": "research/alpha-inbox.md",
      "createFileIfItDoesntExist": true,
      "captureFormat": "\n- {{DATE:YYYY-MM-DD HH:mm}} — {{VALUE:Alpha note}}\n",
      "prepend": false,
      "task": false
    }
  ],
  "macros": [],
  "templateFolderPath": "templates"
}
