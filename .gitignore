# Never commit secrets
.env

# Obsidian local UI state — changes every session, causes conflicts with GitHub Actions.
data/vault/.obsidian/workspace.json
data/vault/.obsidian/workspace-mobile.json
data/vault/.obsidian/graph.json
data/vault/.obsidian/plugins/obsidian-git/data.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Logs
*.log

# Editor
.idea/
.vscode/
*.swp

# Obsidian — plugin binaries and scratch files don't belong in version control
data/vault/.obsidian/plugins/
data/vault/Untitled*.canvas

# Backup files
*.bak
