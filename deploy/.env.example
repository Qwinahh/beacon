# Beacon X Bot — Environment Variables
# Copy this to .env (one directory up, at repo root) and fill in your values.
# This file is safe to commit. .env is gitignored.

# ---- GitHub Personal Access Token ----
# Needs: repo scope (read + write)
# Create at: https://github.com/settings/tokens
GH_PAT=ghp_your_token_here

# ---- X / Twitter API (OAuth 1.0a — required) ----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---- X Bearer Token (optional — some API calls use it) ----
X_BEARER_TOKEN=

# ---- X Cookie scraping (twscrape — required for reading/engagement) ----
# Get from browser DevTools on x.com — Network tab, copy Cookie header value
X_SCRAPER_COOKIES=

# ---- LLM Providers — set at least one ----
ANTHROPIC_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# ---- Optional alpha data sources ----
WHALE_ALERT_API_KEY=
DROPSTAB_API_KEY=

# ---- Optional image generation ----
REPLICATE_API_TOKEN=

# ---- Optional community signals (all fail silently if not set) ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
DISCORD_BOT_TOKEN=
