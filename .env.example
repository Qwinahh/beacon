# ============================================================
# X Bot — Environment Variables
# Copy this to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# --- X / Twitter API ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- GitHub token (optional — raises GitHub API rate limit for alpha signals) ---
GITHUB_TOKEN=

# --- LunarCrush (optional — enables X conversation context in Scout) ---
# Get a key at https://lunarcrush.com/developers
LUNARCRUSH_API_KEY=
