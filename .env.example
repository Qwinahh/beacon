# ============================================================
# X Bot — Environment Variables
# Copy this to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# --- X / Twitter API ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- GitHub token (optional — raises GitHub API rate limit for alpha signals) ---
GITHUB_TOKEN=

# --- X Scraper cookies (free X context — replaces LunarCrush) ---
# Paste your browser cookies from x.com (DevTools → Application → Cookies)
# Format: ct0=<value>; auth_token=<value>
# Set as GitHub Secret named X_SCRAPER_COOKIES
X_SCRAPER_COOKIES=
